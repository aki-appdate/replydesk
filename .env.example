# Firebase の Web アプリ設定（Firebase コンソール → プロジェクトの設定 → マイアプリ）
# すべて空のままでも動きます（その場合はブラウザ内保存＋見本の返答）。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check（reCAPTCHA v3 のサイトキー）。Firebase AI Logic を使うには必須
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# 使う Gemini のモデル（省略時は gemini-3.5-flash-lite）
NEXT_PUBLIC_GEMINI_MODEL=
